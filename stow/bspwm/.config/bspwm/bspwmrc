#!/bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &
pgrep -x picom > /dev/null || picom &


feh --bg-fill "$HOME/.local/share/wallpapers/Tree_Wallpaper.jpg" &

# Set left and right monitors correctly
xrandr --output DP-5 --right-of HDMI-0

bspc monitor HDMI-0 -d 1 2 3 4 5 6  
bspc monitor DP-5 -d 11 12 13 14 15 16



bspc config border_width 2
bspc config window_gap 8
bspc config focused_border_color '#7dcfff'
bspc config border_width 4

bspc config split_ratio 0.5
bspc config borderless_monocle true
bspc config gapless_monocle false


