```sxhkd
# wm independent hotkeys

# terminal emulator
super + Return
	kitty

# program launcher
super + @space
	rofi -show drun

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

alt + h
    bspc node -f west

alt + j
    bspc node -f south

alt + k
    bspc node -f north

alt + l
    bspc node -f east


# ------------------------------------------------------------
# Swap managed window
# Yabai: alt+shift-h/j/k/l
# ------------------------------------------------------------

alt + shift + h
    bspc node -s west

alt + shift + j
    bspc node -s south

alt + shift + k
    bspc node -s north

alt + shift + l
    bspc node -s east


# ------------------------------------------------------------
# Rotate / flip layout
# ------------------------------------------------------------

alt + shift + r
    bspc node @/ -R 90

alt + shift + x
    bspc node @/ -F horizontal

alt + shift + y
    bspc node @/ -F vertical


# ------------------------------------------------------------
# Resize tiled window
#
# Yabai equivalents:
# alt+shift WASD   -> increase
# super+shift WASD -> decrease
# ------------------------------------------------------------

alt + shift + a
    bspc node -z left -48 0

alt + shift + d
    bspc node -z right 48 0

alt + shift + w
    bspc node -z top 0 -48

alt + shift + s
    bspc node -z bottom 0 48


super + shift + a
    bspc node -z left 48 0

super + shift + d
    bspc node -z right -48 0

super + shift + w
    bspc node -z top 0 48

super + shift + s
    bspc node -z bottom 0 -48


# ------------------------------------------------------------
# Fullscreen / pseudo-tiled
# ------------------------------------------------------------

# Similar idea to Yabai zoom-fullscreen
alt + f
    bspc node -t ~fullscreen

# Useful BSPWM equivalent-ish behavior for zoom-parent
alt + d
    bspc node -t ~pseudo_tiled


# ------------------------------------------------------------
# Balance windows
# ------------------------------------------------------------

alt + shift + 0
    bspc node @/ -B


# ------------------------------------------------------------
# Float / unfloat
# ------------------------------------------------------------

alt + t
    bspc node -t '~floating'


# ------------------------------------------------------------
# Move floating window
# ------------------------------------------------------------

ctrl + shift + a
    bspc node -v -12 0

ctrl + shift + d
    bspc node -v 12 0

ctrl + shift + w
    bspc node -v 0 -12

ctrl + shift + s
    bspc node -v 0 12


# ------------------------------------------------------------
# Preselection / insertion point
#
# This is one of BSPWM's nicest features.
# Similar concept to yabai --insert.
# ------------------------------------------------------------

alt + e
    bspc node -p cancel

ctrl + alt + h
    bspc node -p west

ctrl + alt + j
    bspc node -p south

ctrl + alt + k
    bspc node -p north

ctrl + alt + l
    bspc node -p east


# ------------------------------------------------------------
# Focus paired desktops
#
# Monitor 1: 1 2 3 4 5 6
# Monitor 2: 11 12 13 14 15 16
#
# Switching workspace groups changes both monitors while
# preserving which monitor currently has keyboard focus.
# ------------------------------------------------------------

super + 1
    m=$(bspc query -M -m --names); bspc desktop 1 -f; bspc desktop 11 -f; bspc monitor "$m" -f

super + 2
    m=$(bspc query -M -m --names); bspc desktop 2 -f; bspc desktop 12 -f; bspc monitor "$m" -f

super + 3
    m=$(bspc query -M -m --names); bspc desktop 3 -f; bspc desktop 13 -f; bspc monitor "$m" -f

super + 4
    m=$(bspc query -M -m --names); bspc desktop 4 -f; bspc desktop 14 -f; bspc monitor "$m" -f

super + 5
    m=$(bspc query -M -m --names); bspc desktop 5 -f; bspc desktop 15 -f; bspc monitor "$m" -f

super + 6
    m=$(bspc query -M -m --names); bspc desktop 6 -f; bspc desktop 16 -f; bspc monitor "$m" -f


# ------------------------------------------------------------
# Send window to desktop
# ------------------------------------------------------------

ctrl + shift + {1-9,0}
    bspc node -d '^{1-9,10}'


# ------------------------------------------------------------
# Send window to paired desktop AND follow it
#
# Keeps the window on the same physical monitor:
#
# Monitor 1: 1  2  3  4  5  6
# Monitor 2: 11 12 13 14 15 16
# ------------------------------------------------------------
