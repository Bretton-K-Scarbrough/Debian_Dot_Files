#
# shift + super + 3
#     cur=$(bspc query -M -m); first=$(bspc query -M | head -n 1); if [ "$cur" = "$first" ]; then bspc node -d 3 --follow; else bspc node -d 13 --follow; fi
#
# shift + super + 4
#     cur=$(bspc query -M -m); first=$(bspc query -M | head -n 1); if [ "$cur" = "$first" ]; then bspc node -d 4 --follow; else bspc node -d 14 --follow; fi
#
# shift + super + 5
#     cur=$(bspc query -M -m); first=$(bspc query -M | head -n 1); if [ "$cur" = "$first" ]; then bspc node -d 5 --follow; else bspc node -d 15 --follow; fi
#
# shift + super + 6
#     cur=$(bspc query -M -m); first=$(bspc query -M | head -n 1); if [ "$cur" = "$first" ]; then bspc node -d 6 --follow; else bspc node -d 16 --follow; fi
#
# ------------------------------------------------------------
# Send window to paired desktop AND follow it
#
# Monitor 1: 1  2  3  4  5  6
# Monitor 2: 11 12 13 14 15 16
# ------------------------------------------------------------

shift + super + {1-6}
    d=$(bspc query -D -d --names); n={1-6}; if [ "$d" -ge 11 ]; then n=$((n + 10)); fi; bspc node -d "$n" --follow

# ------------------------------------------------------------
# Previous / next desktop
# ------------------------------------------------------------

# ctrl + shift + z
#     bspc desktop -f prev.local
#
# ctrl + shift + x
#     bspc desktop -f next.local


# ------------------------------------------------------------
# Monitors
# ------------------------------------------------------------

ctrl + alt + z
    bspc monitor -f prev

ctrl + alt + x
    bspc monitor -f next


# Send window to next monitor and follow
shift + super + l
    bspc node -m next --follow

shift + super + h
    bspc node -m prev --follow


# ------------------------------------------------------------
# Close / kill window
# ------------------------------------------------------------

super + w
    bspc node -c

alt + shift + q
    bspc node -k


super + Tab
    bspc node -f last

# ------------------------------------------------------------
# Lock and Suspend
# ------------------------------------------------------------
ctrl + shift + l
    i3lock -c 1a1b26

ctrl + shift + s 
    systemctl suspend
