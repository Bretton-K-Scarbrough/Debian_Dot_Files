* {
    bg:       #1A1B26;
    bg-alt:   #24283B;
    fg:       #A9B1D6;
    blue:     #7AA2F7;
    purple:   #BB9AF7;

    background-color: transparent;
    text-color: @fg;

    font: "STIX Two Text 16";
}

window {
    location: center;
    anchor: center;

    width: 650px;

    background-color: @bg;
    border: 2px;
    border-color: @blue;
    border-radius: 14px;

    padding: 12px;
}

mainbox {
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;

    border-radius: 10px;
    padding: 14px;

    children: [ prompt, entry ];
}

prompt {
    text-color: @blue;
    str: "⌕";
    padding: 0px 10px 0px 0px;
}

entry {
    placeholder: "Spotlight Search";
    placeholder-color: #565F89;
}

listview {
    lines: 6;
    columns: 1;

    spacing: 4px;

    fixed-height: false;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 8px;
}

element selected {
    background-color: @blue;
    text-color: @bg;
}

element-icon {
    size: 28px;
    margin: 0px 12px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
